PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=comparaia
DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=comparaia-files

JWT_SECRET=replace-me-with-strong-secret
JWT_EXPIRES_IN=24h

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# Opcional: cria admin na seed do master (obrigatório definir senha forte)
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=please-change-me

# OpenAI (opcional)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_ORG_ID=org_...
# OPENAI_PROJECT=proj_...
# OPENAI_TIMEOUT_MS=60000

# PDF (opcional - backend)
# Use quando o Chromium do Playwright não puder ser executado pelo ambiente.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe

