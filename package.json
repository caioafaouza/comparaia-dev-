{
  "name": "compara-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm --workspace server run dev\"",
    "dev:client": "vite",
    "dev:server": "npm --workspace server run dev",
    "build": "npm run build:client && npm --workspace server run lint",
    "build:client": "vite build",
    "start": "npm --workspace server run start",
    "start:prod": "npm --workspace server run start",
    "start:api": "node server/index.js",
    "start:processor": "node server/processorRunner.js",
    "migrate:master": "npm --workspace server run migrate:master",
    "lint": "eslint server/index.js server/controllers server/middleware server/services server/db server/migrations server/config --ext .js --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "mercadopago": "^2.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "tinymce": "^8.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "axios": "^1.13.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^27.4.0",
    "jsonwebtoken": "^9.0.3",
    "msw": "^2.12.7",
    "playwright-chromium": "^1.58.0",
    "playwright-core": "^1.58.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
