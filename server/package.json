{
  "name": "compara-ia-server",
  "version": "1.0.0",
  "description": "Backend for Compara IA",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint index.js controllers middleware services db migrations config --ext .js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:pubsub": "node scripts/verify_pubsub.js",
    "test:ledger": "node tests/ledger.concurrency.simple.js",
    "test:prod-ready": "npm run test:pubsub && npm run test:ledger",
    "migrate:master": "knex migrate:latest --env development",
    "migrate:tenant": "knex migrate:latest --env tenant_template",
    "seed:master": "knex seed:run --env development",
    "seed:direct": "node scripts/seed_direct_sql.cjs",
    "provision:qa": "node scripts/provision_qa_tenant.cjs",
    "verify:schemas": "node scripts/verify_master_schema.cjs && node scripts/verify_tenant_schema.cjs",
    "reset:full": "cross-env ALLOW_DB_NUKE=true node scripts/reset_database_full.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@napi-rs/canvas": "^0.1.89",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mercadopago": "^2.12.0",
    "minio": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "openai": "^6.17.0",
    "pdf-parse": "^1.1.4",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "playwright-chromium": "^1.58.0",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^5.1.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  }
}
