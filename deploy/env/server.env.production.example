# Production Environment Configuration for Compara IA Server
# Copy to server/.env and fill in real values
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS

# Node Environment
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=comparaia
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=comparaia
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=comparaia
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# MinIO / S3 Storage
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_BUCKET=comparaia

# Security
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=24h
KEY_ENCRYPTION_SECRET=CHANGE_ME_64_HEX_CHARS_EXAMPLE_1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Application
CORS_ORIGINS=https://comparaia.example.com
LOG_LEVEL=info
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Feature Flags
PUBSUB_GATE_STRICT=false
ENABLE_MOCK_AI=false

# URLs
BASE_URL=https://comparaia.example.com
API_URL=https://comparaia.example.com/api
