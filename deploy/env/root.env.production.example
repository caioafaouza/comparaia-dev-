# Production Environment Configuration (Root Level)
# Copy to .env if needed for root-level scripts
# Most projects only need server/.env

# Node Environment
NODE_ENV=production

# Database (if root scripts need access)
DB_HOST=localhost
DB_PORT=5432
DB_USER=comparaia
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=comparaia

# Redis (if root scripts need access)
REDIS_HOST=localhost
REDIS_PORT=6379
